# Response headers for Cloudflare Workers static assets (not used by GitHub Pages).
# No includeSubDomains in HSTS: tabaibi-panel and the hotel chats live on
# subdomains served by other providers.
# CSP enforced since 23-nov after three days report-only (modern-web-review point 12)
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Speculation-Rules: "/speculationrules.json"
  Content-Security-Policy: default-src 'self'; script-src 'self' https://gc.zgo.at; connect-src 'self' https://sanchesque.goatcounter.com; img-src 'self' data: https://sanchesque.goatcounter.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Garaticker help is generated by Zensical with inline scripts that change on every sync
/garaticker/help/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline'; connect-src 'self' https://sanchesque.goatcounter.com; img-src 'self' data: https://sanchesque.goatcounter.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/en/garaticker/help/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline'; connect-src 'self' https://sanchesque.goatcounter.com; img-src 'self' data: https://sanchesque.goatcounter.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/speculationrules.json
  Content-Type: application/speculationrules+json

# 30 days, not immutable: the font files keep the same name when brand updates them
/fonts/*
  Cache-Control: public, max-age=2592000

# OG image and email logos are loaded by Gmail and social networks
/img/*
  Cache-Control: public, max-age=604800
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
